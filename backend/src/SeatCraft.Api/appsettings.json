{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ]
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=seatcraft.db"
  },
  "Jwt": {
    "Issuer": "seatcraft",
    "Audience": "seatcraft-api",
    "SigningKey": "",
    "ExpiryMinutes": 480
  },
  "EnableSwagger": true,
  "AllowedHosts": "*"
}
