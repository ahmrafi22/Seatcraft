{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=seatcraft.db"
  },
  "Jwt": {
    "SigningKey": "local-development-signing-key-not-for-production-use"
  },
  "EnableSwagger": true
}
