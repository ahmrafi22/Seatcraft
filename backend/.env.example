# Copy to .env next to this file; docker compose reads it automatically.
POSTGRES_DB=seatcraft
POSTGRES_USER=seatcraft
POSTGRES_PASSWORD=replace-with-a-long-random-value
JWT_SIGNING_KEY=replace-with-32-plus-random-characters
API_PORT=8080

# Lets an admin trigger the demo seeder in production. Off by default; the
# public demo host sets it to true. The endpoint is admin-only either way.
DEMO_SEED_ENABLED=false
