# Copy to .env.local for development, or set these in the Vercel project settings.
# Every value below is read on the server only — none of them reach the browser.

# Where the Next server calls the API. On the VPS this is the docker address
# (http://api:8080); on Vercel it is the public origin.
SEATCRAFT_API_ORIGIN=https://seatcraft.duckdns.org

# Prefix for the signed download URL the *browser* follows. Empty means same
# origin, which is what nginx gives you. On Vercel set it to the API origin.
SEATCRAFT_PUBLIC_API_ORIGIN=https://seatcraft.duckdns.org

# One-click demo sign-in. Unset: on in development, off in production.
# 1 forces the button on, 0 forces it off.
SEATCRAFT_DEMO_LOGIN=1
SEATCRAFT_DEMO_EMAIL=admin@demo.test
SEATCRAFT_DEMO_PASSWORD=Passw0rd!123
